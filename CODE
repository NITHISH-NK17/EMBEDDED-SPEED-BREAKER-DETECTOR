
#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <TinyGPSPlus.h>

// -------- PIN CONFIGURATION --------
#define SDA_PIN 21
#define SCL_PIN 22

#define GPS_RX 16
#define GPS_TX 17

#define BUZZER_PIN 25

// -------- OBJECTS --------
Adafruit_MPU6050 mpu;
Adafruit_SSD1306 display(128, 64, &Wire, -1);

HardwareSerial gpsSerial(2);
TinyGPSPlus gps;

// -------- SETTINGS --------
const float DETECTION_THRESHOLD = 3.0;
const unsigned long ALERT_DURATION = 1000;
const unsigned long COOLDOWN = 3000;

unsigned long lastDetection = 0;
unsigned long alertStart = 0;

bool alertActive = false;

float acceleration = 0;

void setup() {

  Serial.begin(115200);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  // I2C initialization
  Wire.begin(SDA_PIN, SCL_PIN);

  // MPU6050 initialization
  if (!mpu.begin()) {
    Serial.println("MPU6050 not detected!");
    while (1) {
      delay(100);
    }
  }

  mpu.setAccelerometerRange(
    MPU6050_RANGE_8_G
  );

  mpu.setGyroRange(
    MPU6050_RANGE_500_DEG
  );

  mpu.setFilterBandwidth(
    MPU6050_BAND_21_HZ
  );

  // GPS initialization
  gpsSerial.begin(
    9600,
    SERIAL_8N1,
    GPS_RX,
    GPS_TX
  );

  // OLED initialization
  if (!display.begin(
    SSD1306_SWITCHCAPVCC,
    0x3C
  )) {
    Serial.println("OLED not detected!");
    while (1) {
      delay(100);
    }
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 10);
  display.println("SPEED BREAKER");
  display.println("DETECTOR");
  display.println("System Starting...");
  display.display();

  delay(2000);

  Serial.println("System Ready!");
}

// -------- MAIN LOOP --------

void loop() {

  // Read GPS continuously
  while (gpsSerial.available()) {
    gps.encode(gpsSerial.read());
  }

  // Read MPU6050
  sensors_event_t accel, gyro, temp;

  mpu.getEvent(
    &accel,
    &gyro,
    &temp
  );

  // Calculate acceleration magnitude
  float magnitude = sqrt(
    accel.acceleration.x * accel.acceleration.x +
    accel.acceleration.y * accel.acceleration.y +
    accel.acceleration.z * accel.acceleration.z
  );

  // Remove approximate gravity component
  acceleration = abs(magnitude - 9.81);

  Serial.print("Acceleration Change: ");
  Serial.println(acceleration);

  unsigned long now = millis();

  // Detect possible speed breaker
  if (
    acceleration > DETECTION_THRESHOLD &&
    now - lastDetection > COOLDOWN
  ) {

    detectSpeedBreaker();

    lastDetection = now;
    alertStart = now;
    alertActive = true;
  }

  // Turn off buzzer after alert duration
  if (
    alertActive &&
    now - alertStart >= ALERT_DURATION
  ) {

    digitalWrite(BUZZER_PIN, LOW);
    alertActive = false;
  }

  updateDisplay();

  delay(50);
}

// -------- DETECTION FUNCTION --------

void detectSpeedBreaker() {

  Serial.println("======================");
  Serial.println("SPEED BREAKER DETECTED");
  Serial.println("======================");

  digitalWrite(BUZZER_PIN, HIGH);

  if (gps.location.isValid()) {

    Serial.print("Latitude: ");
    Serial.println(gps.location.lat(), 6);

    Serial.print("Longitude: ");
    Serial.println(gps.location.lng(), 6);

  } else {

    Serial.println("Waiting for GPS fix...");
  }
}

// -------- OLED DISPLAY --------

void updateDisplay() {

  display.clearDisplay();

  display.setTextSize(1);
  display.setCursor(0, 0);

  display.println("SPEED BREAKER DETECTOR");

  display.println("---------------------");

  display.print("Acceleration: ");
  display.println(acceleration, 2);

  if (alertActive) {

    display.println();
    display.setTextSize(2);
    display.println("DETECTED!");

  } else {

    display.println();
    display.println("Monitoring Road...");
  }

  display.setTextSize(1);
  display.println();

  if (gps.location.isValid()) {

    display.print("GPS: FIX");

  } else {

    display.print("GPS: SEARCHING");
  }

  display.display();
}
